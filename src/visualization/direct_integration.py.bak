import os
import sys
from pathlib import Path
from datetime import datetime
import matplotlib.pyplot as plt

# Add project root to path
project_root = Path(__file__).parent.parent.parent.absolute()
sys.path.insert(0, str(project_root))

from src.visualization.intelligent_planogram_generator import IntelligentPlanogramGenerator, create_intelligent_cases_planogram
from src.data_processing.data_loader import DataLoader

def generate_planograms_for_web(store_name):
    """Generate professional planograms for the web UI using the intelligent generator"""
    # Make sure output directory exists
    output_dir = Path('output')
    output_dir.mkdir(exist_ok=True)
    
    # Map web UI store types to intelligent generator store types
    store_type_mapping = {
        'flagship': 'large',
        'standard': 'medium',
        'express': 'small'
    }
    
    # Determine store type from store name
    web_store_type = 'flagship'
    if 'express' in store_name.lower():
        web_store_type = 'express'
    elif 'standard' in store_name.lower():
        web_store_type = 'standard'
    
    # Load products
    loader = DataLoader()
    try:
        products = loader.load_products_from_file('data/raw/accessories/cases_sales.csv')
        print(f"Loaded {len(products)} iPhone products for planogram generation")
    except Exception as e:
        print(f"Error loading products: {e}")
        products = []
    
    if not products:
        print("No products found, using sample data")
        # Create some sample products if loading fails
        from collections import namedtuple
        Product = namedtuple('Product', ['product_name', 'brand', 'series', 'total_qty', 'pureqty', 'impureqty'])
        
        products = [
            Product('iPhone 16 Pro Max Clear Case', 'Apple', 'iPhone 16 Pro Max', 100, 10, 0),
            Product('iPhone 16 Pro Black Case', 'Apple', 'iPhone 16 Pro', 90, 9, 0),
            Product('iPhone 16 Plus Blue Case', 'Apple', 'iPhone 16 Plus', 80, 8, 0),
            Product('iPhone 16 Green Case', 'Apple', 'iPhone 16 Base', 70, 7, 0),
            Product('iPhone 15 Pro Max Red Case', 'Apple', 'iPhone 15 Pro Max', 60, 6, 0),
            Product('iPhone 15 Pro Pink Case', 'Apple', 'iPhone 15 Pro', 50, 5, 0),
            Product('iPhone 15 Plus Purple Case', 'Apple', 'iPhone 15 Plus', 40, 4, 0),
            Product('iPhone 15 White Case', 'Apple', 'iPhone 15 Base', 30, 3, 0),
        ]
    
    # Generate planograms using the intelligent generator
    try:
        # Use the create_intelligent_cases_planogram function
        result = create_intelligent_cases_planogram(
            products=products,
            store_type=store_type_mapping.get(web_store_type, 'large'),
            store_name=store_name,
            num_walls=3 if web_store_type == 'flagship' else 2 if web_store_type == 'standard' else 1
        )
        
        # Format the results for web UI
        planograms = {}
        for wall_name, wall_result in result.get('results', {}).items():
            wall_num = wall_name.split(' ')[1].split('/')[0]
            planograms[f"wall{wall_num}"] = {
                "planogram_image": wall_result.get('planogram_image', ''),
                "product_details_file": wall_result.get('product_details_file', '')
            }
        
        return {
            "status": "success",
            "store_type": web_store_type,
            "planograms": planograms
        }
    
    except Exception as e:
        print(f"Error generating intelligent planograms: {e}")
        # Fall back to a simpler method if intelligent generation fails
        return generate_fallback_planograms(store_name, web_store_type)

def generate_fallback_planograms(store_name, store_type):
    """Generate simple planograms as a fallback"""
    print(f"Using fallback planogram generation for {store_name}")
    
    # Create a simple generator
    generator = IntelligentPlanogramGenerator()
    
    # Determine number of walls based on store type
    if store_type == 'flagship':
        total_walls = 3
    elif store_type == 'standard':
        total_walls = 2
    else:  # express
        total_walls = 1
    
    # Generate planograms
    results = {}
    for wall_num in range(1, total_walls + 1):
        # Create wall name and focus
        wall_name = f"Wall {wall_num}/{total_walls}"
        if wall_num == 1:
            wall_focus = "iPhone 16 Pro Models"
        elif wall_num == 2:
            wall_focus = "iPhone 16 Standard Models"
        else:
            wall_focus = "Top TPA Brands"
        
        # Generate a simple planogram
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"output/Smart_Cases_Layout_improved_{timestamp}.png"
        
        # Create a simple planogram
        fig, ax = plt.subplots(figsize=(20, 14))
        ax.text(0.5, 0.5, f"Smart Cases Layout - {store_name}\nWall {wall_num}/{total_walls}: {wall_focus}",
                fontsize=20, ha='center', va='center')
        ax.set_xlim(0, 1)
        ax.set_ylim(0, 1)
        ax.axis('off')
        plt.savefig(filename, dpi=300, bbox_inches='tight')
        plt.close(fig)
        
        # Create a simple details file
        details_file = filename.replace('.png', '.txt')
        with open(details_file, 'w') as f:
            f.write(f"Smart Cases Layout - {store_name}\n")
            f.write(f"Wall {wall_num}/{total_walls}: {wall_focus}\n")
            f.write(f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
        
        results[f"wall{wall_num}"] = {
            "planogram_image": filename,
            "product_details_file": details_file
        }
    
    return {
        "status": "success",
        "store_type": store_type,
        "planograms": results
    }
